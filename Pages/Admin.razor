@page "/admin"
@using Microsoft.AspNetCore.Components.Authorization
@using AlbumTracker.Services
@inject IAdminService AdminService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<PageTitle>AlbumTracker - Admin</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="admin-page">
            <h1>🛡️ Admin Dashboard</h1>
            <p class="text-muted">Manage users and system settings</p>

            <section class="admin-section">
                <h2>Registered Users</h2>
                
                @if (_loading)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (_users.Count == 0)
                {
                    <p class="text-muted">No users found.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Email</th>
                                    <th>Last Sign In</th>
                                    <th>Role</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in _users)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(user.PhotoUrl))
                                                {
                                                    <img src="@user.PhotoUrl" 
                                                         alt="@user.DisplayName" 
                                                         class="user-avatar me-2" 
                                                         referrerpolicy="no-referrer" />
                                                }
                                                <span>@(user.DisplayName ?? "Unknown")</span>
                                            </div>
                                        </td>
                                        <td>@(user.Email ?? "N/A")</td>
                                        <td>@(user.LastSignIn?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                                        <td>
                                            @if (user.IsAdmin)
                                            {
                                                <span class="badge bg-danger">Admin</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">User</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" 
                                                    @onclick="() => ToggleAdminRole(user)"
                                                    disabled="@(user.Uid == _currentUserId)">
                                                @(user.IsAdmin ? "Remove Admin" : "Make Admin")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="total-users"><strong>Total Users:</strong> @_users.Count</p>
                }
            </section>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger">
            <h4>Access Denied</h4>
            <p>You do not have permission to access this page.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<UserProfile> _users = [];
    private bool _loading = true;
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (authState.User.IsInRole("Admin"))
        {
            await LoadUsersAsync();
        }

        _loading = false;
    }

    private async Task LoadUsersAsync()
    {
        _users = await AdminService.GetAllUsersAsync();
    }

    private async Task ToggleAdminRole(UserProfile user)
    {
        if (user.Uid == _currentUserId)
            return;

        _loading = true;
        StateHasChanged();

        try
        {
            await AdminService.SetAdminRoleAsync(user.Uid, !user.IsAdmin);
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling admin role: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}

<style>
    .admin-page {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .admin-page h1 {
        font-size: 1.8rem;
        margin-bottom: 0.25rem;
    }

    .admin-section {
        background: #181818;
        border: 1px solid #282828;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1.5rem;
    }

    .admin-section h2 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #282828;
    }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #282828;
    }

    .table {
        margin-top: 0.5rem;
        color: #e0e0e0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table thead th {
        background: #1a1a1a;
        color: #b3b3b3;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #282828;
        padding: 0.75rem 1rem;
    }

    .table tbody tr {
        transition: background 0.15s;
    }

    .table tbody tr:hover {
        background: #1a1a1a;
    }

    .table tbody td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #1e1e1e;
        vertical-align: middle;
    }

    .badge.bg-danger {
        background: rgba(220, 53, 69, 0.2) !important;
        color: #ff6b7a;
        font-weight: 600;
    }

    .badge.bg-secondary {
        background: rgba(128, 128, 128, 0.2) !important;
        color: #b3b3b3;
        font-weight: 600;
    }

    .btn-outline-primary {
        color: #1db954;
        border-color: #1db954;
        font-size: 0.8rem;
    }

    .btn-outline-primary:hover:not(:disabled) {
        background: rgba(29, 185, 84, 0.15);
        color: #1db954;
        border-color: #1db954;
    }

    .btn-outline-primary:disabled {
        color: #555;
        border-color: #333;
        opacity: 0.5;
    }

    .total-users {
        color: #b3b3b3;
        font-size: 0.85rem;
        margin-top: 1rem;
    }

    .total-users strong {
        color: #e0e0e0;
    }
</style>
